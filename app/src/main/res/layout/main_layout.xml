<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fadeScrollbars="false"
    android:layout_marginLeft="3dp"
    android:layout_marginRight="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/heading_yellow"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- HUD Preview (mirrors the 3-line glasses display) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#111111"
            android:padding="10dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/hud_line1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="H ---"
                android:textColor="#00FF00"
                android:textSize="16sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/hud_line2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NAV --"
                android:textColor="#00FF00"
                android:textSize="16sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/hud_line3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ALT ---"
                android:textColor="#00FF00"
                android:textSize="16sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Command buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_hold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HOLD"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:backgroundTint="@color/cmd_hold"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btn_move"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MOVE"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:backgroundTint="@color/cmd_move"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btn_ping"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PING"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:backgroundTint="@color/cmd_ping"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btn_abort"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ABORT"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:backgroundTint="@color/cmd_abort" />
        </LinearLayout>

        <!-- Data Dashboard -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1A1A"
            android:padding="10dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DATA"
                android:textColor="@color/heading_yellow"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <!-- Heading row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="HEADING"
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/data_heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="---"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Bearing row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="BEARING"
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/data_bearing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="---"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Distance to waypoint row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TO WAYPOINT"
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/data_dist_waypoint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="---"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Distance traveled row with reset button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TRAVELED"
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/data_dist_traveled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0m"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btn_reset_dist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RESET"
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:backgroundTint="#444444"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp" />
            </LinearLayout>

            <!-- Elevation row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ELEVATION"
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/data_elevation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="---"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </LinearLayout>

        <!-- Connection status -->
        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Disconnected"
            android:textColor="@color/white"
            android:textSize="@dimen/fontSize"
            android:layout_marginBottom="8dp" />

        <!-- Scan / Stop button -->
        <Button
            android:id="@+id/btn_scan"
            style="@style/darkButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scan for Glasses"
            android:layout_marginBottom="4dp" />

        <!-- Disconnect button (hidden until connected) -->
        <Button
            android:id="@+id/btn_disconnect"
            style="@style/darkButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Disconnect"
            android:visibility="gone"
            android:layout_marginBottom="4dp" />

        <!-- Device list -->
        <ListView
            android:id="@+id/device_list"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="#222222"
            android:divider="#444444"
            android:dividerHeight="1dp"
            android:layout_marginBottom="8dp" />

        <!-- Send section (hidden until connected) -->
        <LinearLayout
            android:id="@+id/send_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/edit_message"
                style="@style/ATAKEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter message"
                android:textColor="@color/white"
                android:textColorHint="#888888"
                android:text="Hello Dragon"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btn_send"
                style="@style/darkButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Send" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
